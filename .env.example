# Restaurant POS — Environment Configuration
# Copy this file to .env and adjust values:  cp .env.example .env

# Flask
SECRET_KEY=change-me-to-a-long-random-string-32plus-chars
HOST=127.0.0.1
PORT=5500
FLASK_ENV=production
# Set to 1 to enable debug / auto-reload (never in production)
FLASK_DEBUG=0
DEBUG=0

# Session cookie: set to true if serving over HTTPS
SESSION_COOKIE_SECURE=false

# Business settings (also configurable via Admin > Settings API)
GST_RATE=5.0

# Production server toggle — set USE_WAITRESS=1 to serve with waitress instead of Flask dev server
USE_WAITRESS=0

# Example: expose on LAN
# HOST=0.0.0.0
# PORT=5500
